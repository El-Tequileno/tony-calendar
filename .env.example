# Copy to .env.local. Keep secrets out of Git.
DATABASE_URL=
# Use a random value of at least 32 characters.
SESSION_SECRET=
# Exact approved email addresses, separated by commas. No ownership verification.
APPROVED_EMAILS=tony@example.com,distributor@example.com
RESEND_API_KEY=
EMAIL_FROM=Tony Calendar <calendar@your-verified-domain.com>
APP_URL=http://localhost:3000
# Explicitly enable an in-memory demo. NEVER use demo mode for real shared records.
DEMO_MODE=false
